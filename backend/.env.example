# === HABITFINANS v2.0 - CONFIGURACIÓN ===

# Base de datos PostgreSQL
# Desarrollo local: postgres://usuario:password@localhost:5432/habitfinans
# Railway: se genera automáticamente
DATABASE_URL=postgresql://usuario:password@localhost:5432/habitfinans

# JWT Secret (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=tu-super-secret-jwt-key-123456789

# Email (para Fase 2 - IA y notificaciones)
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-app-password-gmail
EMAIL_FROM=noreply@habitfinans.app

# Cron Task (hora de enviar resúmenes diarios)
CRON_TIME=0 20 * * *

# Server
PORT=5000
NODE_ENV=development

# Railway (en producción)
# NODE_ENV=production
